{
  "name": "hono-zod-demo",
  "version": "0.0.1",
  "private": true,
  "description": "Hono + Zod OpenAPI Demo",
  "keywords": [
    "hono",
    "zod",
    "openapi",
    "swagger",
    "typescript",
    "rest-api",
    "template"
  ],
  "license": "MIT",
  "author": "chicunic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chicunic/hono-zod-demo.git"
  },
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "start:prod": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc && eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "hono": "^4.12.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.20",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
