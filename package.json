{
  "name": "hono-zod-demo",
  "version": "0.0.1",
  "private": true,
  "description": "Hono + Zod OpenAPI Demo",
  "keywords": [
    "hono",
    "zod",
    "openapi",
    "swagger",
    "typescript",
    "rest-api",
    "template"
  ],
  "license": "MIT",
  "author": "chicunic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chicunic/hono-zod-demo.git"
  },
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "start:prod": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc6 -p tsconfig.build.json",
    "check": "tsc6 && eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
